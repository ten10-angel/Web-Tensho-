---
import '../styles/global.css';

const { title, date, section, summary } = Astro.props;
const displayDate = String(date).replaceAll('-', '.');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <meta name="theme-color" content="#10362c" />
    <title>{title} — Tensho Nishida</title>
  </head>
  <body class="article-page">
    <header class="article-header">
      <a class="brand" href="/" aria-label="Tensho Nishida — ホームへ"><span class="brand-name">Tensho Nishida</span></a>
      <a class="article-header-back" href={`/#${section.toLowerCase()}`}>← {section} に戻る</a>
    </header>
    <main class="article-shell">
      <div class="article-intro">
        <p class="article-kicker">TN / {section} <span>{displayDate}</span></p>
        <h1>{title}</h1>
        <p class="article-summary">{summary}</p>
      </div>
      <div class="article-main"><slot /></div>
      <a class="article-return" href={`/#${section.toLowerCase()}`}>← {section} 一覧に戻る</a>
    </main>
    <footer>
      <a class="brand" href="/"><span class="brand-mark">TN</span><span class="brand-name">TENSHO NISHIDA</span></a>
      <p>PERSONAL ARCHIVE<br />TENSHO NISHIDA</p>
      <p>© 2026 TENSHO NISHIDA</p>
    </footer>
  </body>
</html>
