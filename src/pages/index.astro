---
import '../styles/global.css';
import SiteIcons from '../components/SiteIcons.astro';
import { getCollection } from 'astro:content';
import about from '../content/site/about.json';
import historyData from '../content/site/history.json';

const history = historyData.entries;
const byNewest = (a, b) => String(b.data.date).localeCompare(String(a.data.date));
const works = (await getCollection('work', ({ data }) => data.published)).sort(byNewest);
const journals = (await getCollection('journal', ({ data }) => data.published)).sort(byNewest);
const essays = (await getCollection('essay', ({ data }) => data.published)).sort(byNewest);
const displayDate = (date) => String(date).replaceAll('-', '.');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="西田天祥 — 食卓から、人と社会を考える。歩みと活動、日々の記録をまとめた個人サイト。" />
    <meta name="theme-color" content="#102d25" />
    <title>Tensho Nishida — Personal Archive</title>
    <SiteIcons />
  </head>
  <body>
    <div class="page-progress" aria-hidden="true"><span></span></div>

    <header class="site-header" data-header>
      <a class="brand" href="#home" aria-label="Tensho Nishida — Home">
        <span class="brand-name">Tensho Nishida</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="メインナビゲーション">
        <a href="#about">About</a>
        <a href="#history">History</a>
        <a href="#work">Work</a>
        <a href="#journal">Journal</a>
        <a href="#essay">Essay</a>
      </nav>
    </header>

    <main>
      <section id="home" class="hero" aria-labelledby="hero-title">
        <div class="hero-media" aria-hidden="true"></div>
        <div class="hero-content">
          <div class="hero-rule" aria-hidden="true" data-reveal></div>
          <h1 id="hero-title" data-reveal>
            西田天祥
          </h1>
          <p class="hero-roman" lang="en" data-reveal>Tensho Nishida</p>
          <p class="hero-tagline" data-reveal>食卓から、<br />人と社会を考える。</p>
          <div class="hero-meta" data-reveal>
            <p>北海道出身</p>
            <p>京都府立大学 農学食科学部 <wbr />和食文化科学科</p>
          </div>
          <p class="hero-statement" data-reveal>食と文化、地域と経済、そして家族の未来をつなぐ。<br />そのために、学び、考え、動いています。</p>
          <nav class="hero-nav" aria-label="各セクションへ" data-reveal>
            <a href="#about">ABOUT</a>
            <a href="#history">HISTORY</a>
            <a href="#work">WORK</a>
            <a href="#journal">JOURNAL</a>
            <a href="#essay">ESSAY</a>
            <a class="hero-next" href="#about" aria-label="プロフィールへ進む"><span aria-hidden="true">⟶</span></a>
          </nav>
        </div>
      </section>

      <section id="about" class="section about">
        <div class="section-label" data-reveal><span>01</span> ABOUT</div>
        <div class="about-grid">
          <h2 data-reveal>{about.headlineBefore}<br />{about.headlineMiddle}<em>{about.headlineAccent}</em></h2>
          <div class="about-copy" data-reveal>
            <p class="lead">{about.lead}</p>
            <p>{about.body}</p>
            <dl>
              <div><dt>FROM</dt><dd>{about.from}</dd></div>
              <div><dt>FOCUS</dt><dd>{about.focus}</dd></div>
              <div><dt>STATUS</dt><dd>{about.status}</dd></div>
            </dl>
          </div>
        </div>
        <div class="manifesto" data-reveal>
          <span>OBSERVE</span><i>•</i><span>THINK</span><i>•</i><span>CREATE</span><i>•</i><span>REPEAT</span>
        </div>
      </section>

      <section id="history" class="section history">
        <div class="section-head" data-reveal>
          <div class="section-label"><span>02</span> HISTORY</div>
          <p>SELECTED CHAPTERS<br />FROM MY LIFE</p>
        </div>
        <h2 data-reveal>The path so far.</h2>
        <div class="timeline">
          {history.map((item, index) => (
            <article class="timeline-item" data-reveal>
              <div class="timeline-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
              <p class="timeline-year">{item.year}</p>
              <div class="timeline-content">
                <p class="kicker">{item.phase}</p>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                {item.note && <small>{item.note}</small>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="work" class="section work">
        <div class="section-head" data-reveal>
          <div class="section-label"><span>03</span> WORK</div>
          <p>SELECTED PROJECTS<br />&amp; EXPERIMENTS</p>
        </div>
        <h2 data-reveal>Things I’ve made.</h2>
        <div class="work-grid">
          {works.map((item, index) => (
            <a class="work-card" href={`/work/${item.id}/`} aria-label={`${item.data.title}の詳細を見る`}>
              <span class={`work-image ${item.data.photos?.[0] ? 'has-photo' : item.data.placeholderStyle || 'work-a'}`}>
                {item.data.photos?.[0] && <img src={item.data.photos[0].image} alt={item.data.photos[0].alt || item.data.title} loading="lazy" />}
                <i>{String(index + 1).padStart(2, '0')}</i>
              </span>
              <span class="work-info">
                <span><small>{item.data.type}</small><strong>{item.data.title}</strong></span>
                <span class="circle-arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>
        <p class="prototype-note" data-reveal>※ 初期掲載の作品・ビジュアルはプロトタイプ用の仮素材です。</p>
      </section>

      <section id="journal" class="section journal">
        <div class="journal-intro" data-reveal>
          <div class="section-label"><span>04</span> JOURNAL</div>
          <h2>Small notes,<br />kept close.</h2>
          <p>日々の気づきや、まだ文章になる前の断片。</p>
        </div>
        <div class="journal-list">
          {journals.map((item, index) => (
            <a class="journal-row" href={`/journal/${item.id}/`} data-reveal>
              <span class="journal-no">{String(index + 1).padStart(2, '0')}</span>
              <time datetime={item.data.date}>{displayDate(item.data.date)}</time>
              <strong>{item.data.title || item.data.summary}</strong>
              <span aria-hidden="true">＋</span>
            </a>
          ))}
        </div>
      </section>

      <section id="essay" class="section essays">
        <div class="section-head" data-reveal>
          <div class="section-label"><span>05</span> ESSAY</div>
          <p>LONG-FORM NOTES<br />&amp; REFLECTIONS</p>
        </div>
        <h2 data-reveal>Thinking in public.</h2>
        <div class="essay-list">
          {essays.map((item) => (
            <a class="essay-card" href={`/essay/${item.id}/`} data-reveal>
              <span class="essay-meta"><small>{item.data.category || 'ESSAY'}</small><time datetime={item.data.date}>{displayDate(item.data.date)}</time></span>
              <span class="essay-main"><strong>{item.data.title}</strong><span>{item.data.summary}</span></span>
              <span class="essay-read">{item.data.readingTime || 'READ'}<i aria-hidden="true">→</i></span>
            </a>
          ))}
        </div>
      </section>

      <section class="closing">
        <p data-reveal>THE ARCHIVE CONTINUES</p>
        <h2 data-reveal>Stay curious.<br /><em>Keep moving.</em></h2>
        <a href="mailto:hello@example.com" data-reveal>GET IN TOUCH <span>↗</span></a>
      </section>
    </main>

    <footer>
      <a class="brand" href="#home"><span class="brand-mark">TN</span><span class="brand-name">TENSHO NISHIDA</span></a>
      <p>PERSONAL ARCHIVE<br />TENSHO NISHIDA</p>
      <p>© 2026 TENSHO NISHIDA<br /><button type="button" data-back-top>BACK TO TOP ↑</button></p>
    </footer>

    <script>
      const header = document.querySelector('[data-header]');
      const progress = document.querySelector('.page-progress span');
      const menuButton = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.site-nav');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const onScroll = () => {
        header?.classList.toggle('scrolled', window.scrollY > 24);
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (progress) progress.style.transform = `scaleX(${max ? window.scrollY / max : 0})`;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      menuButton?.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open');
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        document.body.classList.remove('menu-open');
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'メニューを開く');
      }));

      if (reducedMotion) {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      }

      document.querySelector('[data-back-top]')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' }));
    </script>
  </body>
</html>
